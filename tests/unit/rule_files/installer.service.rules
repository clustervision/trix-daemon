#
# Ansible managed
#

groups:
- name: trinityx
  rules:
  - alert: ServiceFailedSystemdGeneric
    expr: 'node_systemd_unit_state{name!~"(dhcpd|named|nginx|luna2-daemon|slurmctld|slurmdbd|munge|sssd|slapd|dirsrv@local|rsyslogd|slurmd|sshd).service", state="failed"} > 0'
    for: 10m
    labels:
      severity: warning
      category: service
    annotations:
      description: 'Service {{ $labels.name }} on server {{ $labels.hostname }} has failed'

  - alert: ServiceFailedProvisioningOnController
    expr: 'node_systemd_unit_state{name=~"(dhcpd|named|nginx|luna2-daemon).service", state="failed", job="luna_controllers"} > 0'
    for: 10m
    labels:
      severity: critical
      category: service
    annotations:
      description: 'Service {{ $labels.name }} on server {{ $labels.hostname }} has failed'

  - alert: ServiceFailedSlurmOnController
    expr: 'node_systemd_unit_state{name=~"(slurmctld|slurmdbd|munge).service", state="failed", job="luna_controllers"} > 0'
    for: 10m
    labels:
      severity: critical
      category: service
    annotations:
      description: 'Service {{ $labels.name }} on server {{ $labels.hostname }} has failed'

  - alert: ServiceFailedAuthenticationOnController
    expr: 'node_systemd_unit_state{name=~"(sssd|slapd|dirsrv@local).service", state="failed", job="luna_controllers"} > 0'
    for: 10m
    labels:
      severity: critical
      category: service
    annotations:
      description: 'Service {{ $labels.name }} on server {{ $labels.hostname }} has failed'

  - alert: ServiceFailedMiscOnController
    expr: 'node_systemd_unit_state{name=~"(rsyslogd).service", state="failed", job="luna_controllers"} > 0'
    for: 10m
    labels:
      severity: critical
      category: service
    annotations:
      description: 'Service {{ $labels.name }} on server {{ $labels.hostname }} has failed'

  - alert: ServiceFailedOnNodes
    expr: 'node_systemd_unit_state{name=~"(rsyslogd|slurmd|sshd|sssd).service", state="failed", job="luna_nodes"} > 0'
    for: 10m
    labels:
      severity: danger
      category: service
      nhc: false
    annotations:
      description: 'Service {{ $labels.name }} on server {{ $labels.hostname }} has failed'

  - alert: LunaDaemonProblemsOnControllers
    expr: 'luna_daemon{available="true", state="failed", job="luna_controllers"} > 0'
    for: 10m
    labels:
      severity: warning
      category: service
      nhc: false
    annotations:
      description: 'Luna daemon component {{ $labels.name }} on server {{ $labels.hostname }} has failed. {{ $labels.info }}'

