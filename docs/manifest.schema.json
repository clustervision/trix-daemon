{
  "$comment": "This code is part of the TrinityX software suite. Copyright (C) 2026 ClusterVision Solutions b.v. GPL-3.0-or-later.",
  "$id": "https://gitlab.taurusgroup.one/clustervision/trix-daemon/docs/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backend": {
      "default": "backend",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "endpoints": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "forward": {
            "default": false,
            "description": "the daemon checks nothing; the service behind decides",
            "type": "boolean"
          },
          "handler": {
            "description": "the backend method",
            "type": "string"
          },
          "methods": {
            "default": [
              "GET"
            ],
            "items": {
              "enum": [
                "GET",
                "POST",
                "PATCH",
                "DELETE"
              ]
            },
            "type": "array"
          },
          "minimum": {
            "description": "the lowest role this endpoint admits",
            "enum": [
              "none",
              "reader",
              "operator",
              "manager",
              "rootus"
            ]
          },
          "path": {
            "description": "under /api/v1/<plugin>; <name> is a segment, <path:name> the rest of the path",
            "type": "string"
          },
          "public": {
            "default": false,
            "description": "no token at all; argue for every use",
            "type": "boolean"
          },
          "render": {
            "additionalProperties": false,
            "properties": {
              "coalesce": {
                "description": "how long a burst of changes is gathered, e.g. 2s",
                "pattern": "^[0-9]+[smhd]?$",
                "type": "string"
              },
              "inputs": {
                "description": "luna.<table> or a declaration of this plugin",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "serve": {
                "description": "served from the last result; empty writes files only",
                "enum": [
                  "",
                  "json"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "schema": {
            "description": "a name under schemas, for the body",
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "token": {
            "default": "user",
            "enum": [
              "user",
              "node"
            ]
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "luna_hooks": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "node.update",
          "node.delete"
        ]
      },
      "type": "object"
    },
    "plugin": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "schemas": {
      "additionalProperties": {
        "type": "object"
      },
      "description": "request bodies by name: field -> {type, optional, items}",
      "type": "object"
    }
  },
  "required": [
    "plugin",
    "endpoints"
  ],
  "title": "trixd plugin manifest",
  "type": "object"
}
