; A sample. trixd reads trixd.ini beside it, which the installer writes; the wheel ships
; only this sample, so an upgrade never replaces a site's trixd.ini.

[LOGGER]
LEVEL = info
LOGFILE = /var/log/trixd/trixd.log
; One of debug, info, warning, error, critical.

[API]
BIND = 0.0.0.0:8050
INSECURE_BIND = 0.0.0.0:8051
PROTOCOL = https
CERTFILE =
KEYFILE =
EXPIRY = 1h
USERNAME = trixd
PASSWORD = trixd
; PROTOCOL is the scheme trixd serves and a peer is reached on, https or http. A site
; serving plain HTTP sets it to http here; it was followed from luna.ini before.
; BIND carries TLS on CERTFILE and KEYFILE: the cluster pair Luna also serves.
; INSECURE_BIND is plain HTTP on every address, for nodes; it is clear text on the network.
; 127.0.0.1:8051 keeps it on the controller alone.

[TOKENS]
ALGORITHM = HS256
SECRET_KEY =
SECRET_FILE = /trinity/local/etc/ssl/secret.key
ISSUER = trixd
PRIVATE_KEY = /trinity/local/etc/ssl/trixd.ed25519
KEY_ID = trixd-1
TRUST = /trinity/local/etc/ssl/trust.d
; HS256 is what luna2-daemon signs with, so either daemon accepts the other's tokens.
; The secret is this daemon's own, generated by the installer as Luna's is; an empty
; SECRET_KEY falls back to SECRET_FILE, which is the file both installers write.

; ALGORITHM = EdDSA uses PRIVATE_KEY, KEY_ID and TRUST instead, so a daemon that
; verifies cannot mint. It needs Luna to speak EdDSA too, and today Luna does not.

; There is no [LUNA] section, and no [TRIGGERS] one. Where Luna answers, its protocol and
; its certificate check are read from Luna's own luna.ini,
; /trinity/local/luna/daemon/config/luna.ini, by the luna plugin, so they are changed in
; one place. A plugin's own settings are its own: they are set through its config
; endpoint and kept with the plugin, not here.

[DATABASE]
URL = sqlite:////trinity/local/trixd/daemon/var/trixd.db

[AUTH]
CHAIN = local, pam
CACHE = 60s
; First answer wins and a failing source is skipped. local is the principal table;
; pam is the controller OS, which reaches 389ds through sssd on a TrinityX box.

[AUTH_PAM]
SERVICE = login

[AUTH_LDAP]
URI =
BASE =
BIND_DN =
BIND_PASSWORD =
USER_ATTRIBUTE = uid
; Only read when ldap is in CHAIN. USER_ATTRIBUTE is sAMAccountName on Active Directory.

[REPLICATION]
PEERS =
INTERVAL = 300s
ENABLED = yes
CA_FILE = /trinity/local/etc/ssl/cluster-ca.crt
; Each peer is host:port of the other controller's TLS listener, named as its certificate
; names it. Empty on a single controller, which has nothing to reconcile with. CA_FILE is
; what a peer's certificate is checked against before the service token is sent.

[AUDIT]
; How long a row of the audit trail is kept. Rows are written in batches.
KEEP = 90d

[SERVICES]
COMMAND = /usr/bin/systemctl
; What runs a unit action, with the unit as its argument, as luna.ini names it. A
; container without systemd points this at its own facade and the plugin is unchanged.

[PLUGINS]
DIRECTORY = /trinity/local/trixd/daemon/plugins
SITE_DIRECTORY = /trinity/local/trixd/plugins
ENABLED = luna, directory, prometheus, services, slurm, genders
; DIRECTORY holds the shipped plugins and is replaced on upgrade; a site's own go in
; SITE_DIRECTORY, which is not, and cannot take a shipped plugin's name. A restart loads
; only what ENABLED lists. slurm and genders write the same blocks luna2-daemon's node
; hook still writes, from the same node list.
