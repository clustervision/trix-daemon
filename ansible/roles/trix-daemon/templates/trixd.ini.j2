; Settings for trixd, the TrinityX daemon. Rendered by the trinity/trix-daemon role.

[LOGGER]
LEVEL = info
LOGFILE = {{ trixd_log_dir }}/trix-daemon.log

[API]
BIND = 0.0.0.0:{{ trixd_tls_port }}
INSECURE_BIND = {{ trixd_plain_bind }}:{{ trixd_plain_port }}
; The same pair luna2's gunicorn.py.j2 is templated from.
CERTFILE = {{ ssl_certificate }}
KEYFILE = {{ ssl_certificate_key }}
EXPIRY = {{ trixd_token_expiry }}
USERNAME = {{ trixd_username }}
PASSWORD = {{ trixd_password }}

[TOKENS]
ALGORITHM = {{ trixd_token_algorithm }}
SECRET_KEY =
SECRET_FILE = {{ trixd_secret_file }}
ISSUER = trix-daemon
PRIVATE_KEY = {{ trixd_key }}
KEY_ID = {{ trixd_key_id }}
TRUST = {{ trixd_trust_dir }}

[LUNA]
ENDPOINT = {{ ansible_hostname }}:7050
PROTOCOL = {{ luna_protocol }}
VERIFY_CERTIFICATE = {{ luna_verify_certificate }}
USERNAME = {{ luna_username }}
PASSWORD = {{ luna_password }}
TIMEOUT = 20s

[DATABASE]
URL = sqlite:///{{ trixd_db_dir }}/trix.db

[AUTH]
CHAIN = {{ trixd_auth_chain }}
CACHE = 60s

[AUTH_PAM]
SERVICE = login

[REPLICATION]
{% if ha | default(False) %}
PEERS = {% for host in all_ctrl_hostname | default([]) if host != ansible_hostname %}{{ host }}:{{ trixd_tls_port }}{% if not loop.last %}, {% endif %}{% endfor %}

{% else %}
PEERS =
{% endif %}
INTERVAL = {{ trixd_replication_interval }}
ENABLED = {{ 'yes' if ha | default(False) else 'no' }}

[TRIGGERS]
LUNA_HASHES = {{ trixd_luna_hash_interval }}

[SERVICES]
COMMAND = {{ trixd_service_command }}

[PLUGINS]
DIRECTORY = {{ trixd_root }}/daemon/plugins
ENABLED = {{ trixd_plugins | join(', ') }}
