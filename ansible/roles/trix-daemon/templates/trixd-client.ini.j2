; Where trixd answers, and the account a client signs in with: the ini account,
; which is rootus. Rendered by the trinity/trix-daemon role beside each luna.ini.
; There is no SECRET_KEY: it signs tokens for both daemons, and a client gains
; nothing from checking a signature it did not issue.

[API]
USERNAME = {{ trixd_username }}
PASSWORD = {{ trixd_password }}
ENDPOINT = {{ trixd_client_endpoint }}:{{ trixd_tls_port }}
PROTOCOL = {{ trixd_client_protocol }}
VERIFY_CERTIFICATE = {{ trixd_verify_certificate }}
